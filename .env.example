# GrantLadder — StudioNet frontend configuration
VITE_NETWORK=studionet
VITE_CHAIN_ID=61999
VITE_STUDIO_RPC=https://studio.genlayer.com/api

# Deployed GrantLadder contract address on StudioNet (set after `npm run deploy`)
VITE_CONTRACT_ADDRESS=0xAfa46288bdbB6b09E2B1A5247aE4d5CeEA17D189

# Deploy/seed keys come from your shell, never committed:
#   source ~/.genlayer/env.sh
# Never place a private key in any VITE_* variable — it ships in the public bundle.
